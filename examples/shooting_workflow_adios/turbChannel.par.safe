[GENERAL]
polynomialOrder = 7
stopAt = endTime
endTime = 400

dt = targetCFL=2 + max=2e-2 + initial=5e-3
timeStepper = tombo3

checkpointControl = simulationTime 
checkpointInterval = -1

regularization = hpfrt + nModes=1 + scalingCoeff=5
constFlowRate = meanVelocity=1.0 + direction=X

[PRESSURE]
residualTol = 1e-04

[VELOCITY]
boundaryTypeMap = zeroValue 
viscosity = 1/10000
rho = 1.0
residualTol = 1e-06

[CASEDATA]
ReTau = 550
xLength = LX 
zLength = LZ 
betaY = 2.2

[MESH]
partitioner = rcb # recommended for this case

